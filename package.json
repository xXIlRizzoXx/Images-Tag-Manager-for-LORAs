{
  "name": "images-tag-manager",
  "private": true,
  "version": "2.0.1",
  "description": "Privacy-focused desktop tool to manage, edit and auto-generate tags for image datasets used in LoRA / Stable Diffusion training.",
  "license": "MIT",
  "author": {
    "name": "xXIlRizzoXx",
    "url": "https://github.com/xXIlRizzoXx"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','release/win-unpacked']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node scripts/check-translations.mjs && node scripts/run-tests.mjs",
    "installer:art": "node scripts/make-installer-art.mjs",
    "electron:dev": "npm run build:mcp && cross-env NODE_ENV=development concurrently \"npm run dev\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "npm run lint && npm test && npm run build && npm run build:mcp && electron-builder",
    "build:mcp": "node scripts/build-mcp.mjs"
  },
  "build": {
    "appId": "com.imagestagmanager.app",
    "productName": "Images Tag Manager for LORAs",
    "copyright": "Copyright xXIlRizzoXx",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "it_IT",
        "fr_FR",
        "es_ES",
        "de_DE",
        "zh_CN",
        "ja_JP",
        "pt_BR",
        "ru_RU"
      ],
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Images Tag Manager for LORAs",
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "warningsAsErrors": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true
    },
    "linux": {
      "icon": "public/icon.png",
      "category": "Graphics"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/mcp-server.cjs",
      "electron/splash.html",
      "electron/splash.js",
      "public/**/*",
      "!**/*.md",
      "!public/__shots/**/*",
      "!dist/__shots/**/*",
      "!node_modules/**/*"
    ],
    "asar": true
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "26.8.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.4",
    "zod": "3.25.76"
  }
}
