node_modules/
# ITALIANO: build/ e' la cartella RISORSE di electron-builder (script installer e
#           immagini del wizard): quelle vanno versionate. L'output va in release/.
# ENGLISH: build/ is electron-builder's RESOURCES dir (installer script + wizard
#          images): those must be tracked. Build output goes to release/.
build/*
!build/installer.nsh
!build/lang-strings.nsh
!build/*.bmp
!build/*.ico
!build/license_*.txt
dist/
# ITALIANO: foto vere copiate da scripts/make-readme-shots.mjs; restano se il giro si interrompe.
# ENGLISH: real photos copied by scripts/make-readme-shots.mjs; left behind if the run is interrupted.
public/__shots/
coverage/
.DS_Store
*.log
.env*
!.env.example


# Electron build output
release/
win-unpacked/
Portable/
*.exe
*.zip

# Claude Code workspace state (worktrees, launch config)
.claude/

# ITALIANO: note di lavoro interne e materiale non destinato al repo pubblico.
# ENGLISH: internal working notes and material not meant for the public repo.
NOTES.md
ANALISI-*.md
BUG.md
Civitai/
_to_delete/

# MCP server bundle, rebuilt by npm run build:mcp
electron/mcp-server.cjs

# Civitai cover work images, rebuilt by scripts/make-cover-civitai.mjs on every run
docs/img/civitai-cover-anteprima.jpg
docs/img/civitai-cover-controllo.jpg
